#!/bin/sh
# 다 받은 파일을 공유폴더 루트에 보이게 한다: 20261011-143022_홍길동_a1b2c3_IMG_1234.HEIC
# mv 가 아니라 하드링크다. .incoming 원본이 남아 있어야, 완료 응답을 놓친 휴대폰이
# 다시 물었을 때 "다 받음"으로 답하고 처음부터 재전송하지 않는다. 같은 볼륨이라 용량은 한 번만 든다.
# 실패해도 파일은 .incoming 에 그대로 남는다 (tusd 로그에만 에러가 찍힘).
set -eu
in=$(cat)
ts=$(TZ=KST-9 date +%Y%m%d-%H%M%S)
src=$(printf '%s' "$in" | jq -r '.Event.Upload.Storage.Path')
# 길이: 이름 12자 + 파일명 40자. 4바이트 글자만 와도 255바이트(파일명 한도) 안에 든다.
# \p{Cf}: 글자 방향 뒤집기(U+202E) 같은 보이지 않는 서식 문자 — "사진.jpg" 로 보이는 .exe 위장 차단
name=$(printf '%s' "$in" | jq -r --arg ts "$ts" '
  def clean: gsub("[/\\\\:*?\"<>|\\p{Cc}\\p{Cf}]"; "_") | sub("^[.\\s]+"; "");
  .Event.Upload as $u
  | [$ts,
     ($u.MetaData.name // "" | clean | .[0:12]),
     $u.ID[0:6],
     ($u.MetaData.filename // "file" | clean | .[-40:])]
  | map(select(. != "")) | join("_")')
ln "$src" "/data/$name"
